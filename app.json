{
  "expo": {
    "name": "KidiConnect",
    "slug": "magic-letter",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/kidiconnect-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/kidiconnect-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kidiconnect-adaptive.png",
        "backgroundColor": "#fff8ee"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "org.accionhonduras.magicletter"
    },
    "web": {
      "favicon": "./assets/kidiconnect-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9da146e3-5c23-418b-98f2-4f062dc33273"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a KidiConnect seleccionar fotografías para la carta.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ]
  }
}
